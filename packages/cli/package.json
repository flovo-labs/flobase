{
  "name": "flobase",
  "version": "0.1.0",
  "type": "module",
  "description": "One YAML. ER diagram, Postgres DDL, and OpenAPI contract — deterministic, not AI-hallucinated.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schema": {
      "import": "./dist/schema.js",
      "types": "./dist/schema.d.ts"
    },
    "./er-generator": {
      "import": "./dist/er-generator.js",
      "types": "./dist/er-generator.d.ts"
    },
    "./pg-generator": {
      "import": "./dist/pg-generator.js",
      "types": "./dist/pg-generator.d.ts"
    },
    "./openapi-generator": {
      "import": "./dist/openapi-generator.js",
      "types": "./dist/openapi-generator.d.ts"
    }
  },
  "bin": {
    "flobase": "./dist/index.js",
    "flobase-cli": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "flobase.schema.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/bin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "flobase",
    "schema",
    "openapi",
    "postgres",
    "er-diagram",
    "cli",
    "codegen"
  ],
  "author": "Sreeju <sreeju@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flovo-labs/flobase.git"
  },
  "bugs": {
    "url": "https://github.com/flovo-labs/flobase/issues"
  },
  "homepage": "https://github.com/flovo-labs/flobase#readme",
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "picocolors": "^1.1.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@types/node": "^22.13.9",
    "@vitest/coverage-v8": "^3.0.7",
    "node-sql-parser": "^5.3.6",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
