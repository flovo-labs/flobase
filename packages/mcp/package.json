{
  "name": "flobase-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "Model Context Protocol (MCP) server for Flobase schema files",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "flobase-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "flobase",
    "mcp",
    "model-context-protocol",
    "cursor",
    "claude-desktop"
  ],
  "author": "Sreeju <sreeju@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flovo-labs/flobase.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "picocolors": "^1.1.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  }
}
